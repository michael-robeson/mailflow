      "position": [660, -100]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error(`Expected one page request, got ${items.length}`);\nreturn [{ json: { requestState: items[0].json } }];"
      },
      "id": "09b00000-0000-4000-8000-000000000010",
      "name": "Preserve Page Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
