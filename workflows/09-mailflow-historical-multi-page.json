    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error(`Expected one page reply, got ${items.length}`);\nreturn [{ json: { page: items[0].json } }];"
      },
      "id": "09b00000-0000-4000-8000-000000000011",
      "name": "Wrap Page Reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": { "includeUnpaired": false }
      },
      "id": "09b00000-0000-4000-8000-000000000012",
      "name": "Pair Page Request and Reply",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [1100, -180]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { historicalLoopResult, historicalFinalReport } = require('mailflow-pipeline');\nconst items = $input.all();\nif (items.length !== 1) throw new Error(`Expected one paired page reply, got ${items.length}`);\nconst { requestState, page } = items[0].json;\nfunction sameValue(a, b) {\n  if (a === b) return true;\n  if (!a || !b || typeof a !== 'object' || typeof b !== 'object' || Array.isArray(a) !== Array.isArray(b)) return false;\n  const aKeys = Object.keys(a).sort();\n  const bKeys = Object.keys(b).sort();\n  return aKeys.length === bKeys.length && aKeys.every((key, index) => key === bKeys[index] && sameValue(a[key], b[key]));\n}\nif (!requestState || !page || !sameValue(requestState, page.previous)) throw new Error('Page reply does not match the parent request state');\nif (page.stopReason) return [{ json: { continue: false, report: historicalFinalReport(requestState, page.stopReason) } }];\nreturn [{ json: historicalLoopResult(requestState, page) }];"
      },
      "id": "09b00000-0000-4000-8000-000000000005",
      "name": "Check Page Progress",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.continue }}", "operation": "equal", "value2": true }]
        }
      },
      "id": "09b00000-0000-4000-8000-000000000006",
      "name": "Continue Ingestion",
