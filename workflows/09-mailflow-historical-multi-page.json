      "position": [0, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { createHistoricalState, openHistoricalForN8n } = require('mailflow-pipeline');\nconst ingestionId = '';\nconst accountKey = '';\nconst query = '';\nconst pageSize = 25;\nconst maxMessages = 100;\nconst enableM1 = false;\nconst configurationRevisionId = null;\nconst config = { ingestionId, accountKey, query, pageSize, maxMessages, enableM1, configurationRevisionId };\ncreateHistoricalState(config);\nreturn [{ json: await openHistoricalForN8n(config) }];"
      },
