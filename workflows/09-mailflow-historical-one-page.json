{
  "name": "09 - Mailflow Historical One Page (SUBWORKFLOW - INACTIVE)",
  "nodes": [
    {
      "parameters": {},
      "id": "09b10000-0000-4000-8000-000000000001",
      "name": "Page Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=' + Math.min($json.pageSize, $json.maxMessages - $json.discovered) + '&fields=messages%28id%29,nextPageToken' + ($json.query ? '&q=' + encodeURIComponent($json.query) : '') + ($json.nextPageToken ? '&pageToken=' + encodeURIComponent($json.nextPageToken) : '') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "id": "09b10000-0000-4000-8000-000000000002",
      "name": "List Gmail Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput",
      "position": [220, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { prepareHistoricalPage, HistoricalPaginationError } = require('mailflow-pipeline');\nconst previous = $('Page Input').first().json;\nconst response = $input.first().json;\nif (response.error) return [{ json: { previous, stopReason: 'list_failure' } }];\ntry {\n  return [{ json: { previous, ...prepareHistoricalPage(previous, response) } }];\n} catch (error) {\n  if (!(error instanceof HistoricalPaginationError)) throw error;\n  return [{ json: { previous, stopReason: 'pagination_failure' } }];\n}"
      },
      "id": "09b10000-0000-4000-8000-000000000003",
      "name": "Prepare Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ Boolean($json.stopReason) }}", "operation": "equal", "value2": true }]
        }
      },
      "id": "09b10000-0000-4000-8000-000000000004",
      "name": "List Failed",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [660, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.messages.length > 0 }}", "operation": "equal", "value2": true }]
        }
      },
      "id": "09b10000-0000-4000-8000-000000000005",
      "name": "Has Messages",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [880, 120]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.first().json.messages.map((message) => ({ json: message }));"
      },
      "id": "09b10000-0000-4000-8000-000000000006",
      "name": "Expand Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + encodeURIComponent($json.id) + '?format=full' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": { "response": { "response": { "neverError": true, "responseFormat": "json", "fullResponse": true } } }
      },
      "id": "09b10000-0000-4000-8000-000000000007",
      "name": "Get Full Gmail Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [1320, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { processGmailResponse, persistHistoricalPageForN8n, persistVersionedHistoricalMessagesForN8n } = require('mailflow-pipeline');\nconst page = $('Prepare Page').first().json;\nconst requests = $('Expand Messages').all();\nconst responses = $input.all();\nif (responses.length !== requests.length || requests.length > page.state.pageSize) throw new Error('Gmail response count does not match requests');\nconst processed = new Array(requests.length);\nconst versionedMessages = [];\nfor (const response of responses) {\n  const index = response.pairedItem?.item;\n  if (!Number.isInteger(index) || index < 0 || index >= requests.length || processed[index]) throw new Error('Invalid Gmail response association');\n  processed[index] = processGmailResponse(requests[index].json.id, response.json, index + 1);\n  if (page.state.versionedEvaluation?.enabled === true && !['retrieval_error', 'processing_error'].includes(processed[index].decision.status)) {\n    versionedMessages.push(response.json.body);\n  }\n}\nif (page.state.versionedEvaluation?.enabled === true) {\n  await persistVersionedHistoricalMessagesForN8n(page.state, versionedMessages);\n}\nreturn [{ json: { previous: page.previous, ...await persistHistoricalPageForN8n(page.state, processed) } }];"
      },
      "id": "09b10000-0000-4000-8000-000000000008",
      "name": "Process and Persist Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 0]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { persistHistoricalPageForN8n } = require('mailflow-pipeline');\nconst page = $input.first().json;\nreturn [{ json: { previous: page.previous, ...await persistHistoricalPageForN8n(page.state, []) } }];"
      },
      "id": "09b10000-0000-4000-8000-000000000009",
      "name": "Persist Empty Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 240]
    }
  ],
  "connections": {
    "Page Input": { "main": [[{ "node": "List Gmail Page", "type": "main", "index": 0 }]] },
    "List Gmail Page": { "main": [[{ "node": "Prepare Page", "type": "main", "index": 0 }]] },
    "Prepare Page": { "main": [[{ "node": "List Failed", "type": "main", "index": 0 }]] },
    "List Failed": { "main": [[], [{ "node": "Has Messages", "type": "main", "index": 0 }]] },
    "Has Messages": { "main": [[{ "node": "Expand Messages", "type": "main", "index": 0 }], [{ "node": "Persist Empty Page", "type": "main", "index": 0 }]] },
    "Expand Messages": { "main": [[{ "node": "Get Full Gmail Message", "type": "main", "index": 0 }]] },
    "Get Full Gmail Message": { "main": [[{ "node": "Process and Persist Page", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  },
  "active": false,
  "pinData": {}
}
