{
  "name": "06 - Mailflow Gmail Persistence (MANUAL - INACTIVE)",
  "nodes": [
    {
      "parameters": {},
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30001",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const limit = 25;\nconst query = 'newer_than:14d';\nconst accountKey = '';\nconst runId = '';\nif (!Number.isInteger(limit) || limit < 1 || limit > 25) throw new Error('Invalid message limit');\nif (typeof query !== 'string') throw new Error('Invalid query');\nif (!/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(runId)) throw new Error('Configure an explicit run UUID before execution');\nif (!/^[A-Za-z0-9_-]{1,128}$/.test(accountKey)) throw new Error('Invalid account key');\nreturn [{ json: { limit, query, accountKey, runId } }];"
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30002",
      "name": "Configure Persistence Run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages?maxResults=' + $json.limit + '&fields=messages%28id%29' + ($json.query ? '&q=' + encodeURIComponent($json.query) : '') }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {}
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30003",
      "name": "List Gmail Messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { prepareGmailMessageList } = require('mailflow-pipeline');\nconst limit = $('Configure Persistence Run').first().json.limit;\nconst messages = prepareGmailMessageList($input.first()?.json, limit);\nreturn messages.length ? messages.map((message) => ({ json: { hasMessage: true, ...message } })) : [{ json: { hasMessage: false } }];"
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30004",
      "name": "Prepare Message IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.hasMessage }}",
              "operation": "equal",
              "value2": true
            }
          ]
        }
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30005",
      "name": "Has Messages",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + encodeURIComponent($json.id) + '?format=full' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json",
              "fullResponse": true
            }
          }
        }
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30006",
      "name": "Get Full Gmail Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueRegularOutput",
      "position": [
        1100,
        -100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { processGmailResponse } = require('mailflow-pipeline');\nconst requests = $('Prepare Message IDs').all();\nconst responses = $input.all();\nif (responses.length !== requests.length || requests.length > 25) throw new Error('Gmail response count does not match requests');\nconst processed = new Array(requests.length);\nfor (const response of responses) {\n  const index = response.pairedItem?.item;\n  if (!Number.isInteger(index) || index < 0 || index >= requests.length || processed[index]) throw new Error('Invalid Gmail response association');\n  processed[index] = { json: processGmailResponse(requests[index].json.id, response.json, index + 1) };\n}\nreturn processed;"
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30007",
      "name": "Process Gmail Responses",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { persistForN8n } = require('mailflow-pipeline');\nconst { runId, accountKey } = $('Configure Persistence Run').first().json;\nreturn [{ json: await persistForN8n(runId, accountKey, $input.all().map((item) => item.json)) }];"
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30008",
      "name": "Persist and Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const { persistForN8n } = require('mailflow-pipeline');\nconst { runId, accountKey } = $('Configure Persistence Run').first().json;\nreturn [{ json: await persistForN8n(runId, accountKey, []) }];"
      },
      "id": "c49fb2a0-f696-44f4-bcb1-38da44b30009",
      "name": "Persist Empty and Report",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        140
      ]
    }
  ],
